rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{uid}/{fileName} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    match /labAssets/{experimentId}/{fileName} { allow read: if request.auth != null; allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['faculty', 'admin']; }
  }
}
